# ViaCEP and the currency rate API (Frankfurter) used by Simplify are both free and keyless,
# so no secrets are required to run the app locally.
#
# The contact form uses EmailJS, whose "public key" is designed to be exposed in client code
# (see https://www.emailjs.com/docs/sdk/installation/), but it is still kept out of source
# control so each deployment (yours, a fork, CI) can use its own EmailJS account.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
